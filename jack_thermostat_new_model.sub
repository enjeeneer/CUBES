#!/bin/bash
#SBATCH -A CABRERA-SERRENHO-SL3-CPU
#SBATCH -p icelake
#SBATCH --mem=6840
#SBATCH -N 1
#SBATCH -t 00:30:00
#SBATCH -J p-jjjl-case-sweep
#SBATCH --array=0-1

source ~/.bashrc

# Build parameter list
PARAMS=()
zones=(0 9)
heating_patterns=("twice")

for z in "${zones[@]}"; do
    for pattern in "${heating_patterns[@]}"; do
        PARAMS+=("--exp_typ thermostat --zone $z --heating_pattern $pattern --algorithm rbc --case 0 --rep H28 --wandb_name model_validation --wandb_tags model_validation --year 2023 --comfort_temp_setpoint 20 --setback_temp_setpoint 16 --wandb_entity jjjl4 --wandb_project jack-observations --run_id True --timesteps_per_hour 60 --holiday True --short_episode False --inactivity_threshold 15 --wandb_logging False --no_ventilation True")
    done
done

# Defensive index check
if [ "$SLURM_ARRAY_TASK_ID" -ge "${#PARAMS[@]}" ]; then
    echo "SLURM_ARRAY_TASK_ID ($SLURM_ARRAY_TASK_ID) out of range for PARAMS array"
    exit 1
fi

# Run with Singularity
singularity run cubes-cluster.simg python3.9 main_jack.py ${PARAMS[$SLURM_ARRAY_TASK_ID]}
