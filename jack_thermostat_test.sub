#!/bin/bash
#SBATCH -A CABRERA-SERRENHO-SL3-CPU
#SBATCH -p icelake
#SBATCH --mem=6840
#SBATCH -N 1
#SBATCH -t 00:30:00
#SBATCH -J p-jjjl-SYNTHETIC
#SBATCH --array=0-11  # Total 12 jobs (6 reps * 2 zones)

source ~/.bashrc

# Define the `rep` values and `zones` you want to vary
REPS=("H09" "H11" "H28" "H30" "H33" "H43")
ZONES=(0 9)

# Create the PARAMS array dynamically by looping over both `rep` and `zone`
PARAMS=()
for rep in "${REPS[@]}"; do
    for zone in "${ZONES[@]}"; do
        PARAMS+=("--exp_typ thermostat --zone $zone --heating_pattern twice --algorithm rbc --case 0 --rep $rep --wandb_name holiday_check --wandb_tags holiday_check --year 2023 --comfort_temp_setpoint 20 --setback_temp_setpoint 16 --wandb_entity jjjl4 --wandb_project jack-observations --run_id True --timesteps_per_hour 60 --holiday True")
    done
done

# Run the job with singularity using the task ID as an index for PARAMS
singularity run cubes-cluster.simg python3.9 main_jack.py ${PARAMS[$SLURM_ARRAY_TASK_ID]}
