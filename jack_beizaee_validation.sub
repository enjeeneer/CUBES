#!/bin/bash
#SBATCH -A CABRERA-SERRENHO-SL3-CPU
#SBATCH -p icelake
#SBATCH --mem=6840
#SBATCH -N 1
#SBATCH -t 01:30:00
#SBATCH -J heating-exps

source ~/.bashrc

# Define the PARAMS array dynamically:
PERIODS=("lynch" "beizaee")
CONTROLS=("conventional_control" "zonal_control" "occupancy_control")
PART_LOADS=("0_0" "0_2" "0_4")
EFFICIENCIES=("constant" "quadratic" "cubic")

# Generate all combinations of the parameters and add them to the PARAMS array
for PERIOD in "${PERIODS[@]}"; do
    for CONTROL in "${CONTROLS[@]}"; do
        for PART_LOAD in "${PART_LOADS[@]}"; do
            for EFFICIENCY in "${EFFICIENCIES[@]}"; do
                # Run the job with singularity using the current combination of parameters
                echo "▶ Running: $CONTROL $PERIOD $PART_LOAD $EFFICIENCY"
                singularity run cubes-cluster.simg python3.9 run_exps.py --experiment $CONTROL --period $PERIOD --part_load $PART_LOAD --efficiency $EFFICIENCY

                # Check if the command was successful
                STATUS=$?
                if [ $STATUS -ne 0 ]; then
                  echo "❌ Error in: $CONTROL $PERIOD $PART_LOAD $EFFICIENCY"
                fi
            done
        done
    done
done
