#!/bin/bash
#SBATCH -A CABRERA-SERRENHO-SL3-CPU
#SBATCH -p icelake
#SBATCH --mem=6840
#SBATCH -N 1
#SBATCH -t 01:30:00
#SBATCH -J heating-exps

source ~/.bashrc

PERIODS=("lynch" "beizaee")
CONTROLS=("conventional_control" "zonal_control" "occupancy_control")
PART_LOADS=("0_0" "0_2" "0_4")
EFFICIENCIES=("constant" "quadratic" "cubic")
MODES=("validation" "evaluation")

for MODE in "${MODES[@]}"; do
    for PERIOD in "${PERIODS[@]}"; do
        for CONTROL in "${CONTROLS[@]}"; do
            for PART_LOAD in "${PART_LOADS[@]}"; do
                for EFFICIENCY in "${EFFICIENCIES[@]}"; do
                    echo "▶ Running: $CONTROL $PERIOD $PART_LOAD $EFFICIENCY $MODE"
                    singularity run cubes-cluster.simg python3.9 run_exps.py \
                        --experiment $CONTROL \
                        --period $PERIOD \
                        --part_load $PART_LOAD \
                        --efficiency $EFFICIENCY \
                        --mode $MODE

                    STATUS=$?
                    if [ $STATUS -ne 0 ]; then
                        echo "❌ Error in: $CONTROL $PERIOD $PART_LOAD $EFFICIENCY $MODE"
                    fi
                done
            done
        done
    done
done
