! Minimal output variables for coheat analysis
! Only includes variables actually used by the analysis code

! ================================================================
! CRITICAL: Ideal Loads Heating Energy (for energy calculations)
! ================================================================
OUTPUT:VARIABLE,
    *,                        !- Key Value
    Zone Ideal Loads Supply Air Total Heating Energy,    !- Variable Name
    TimeStep;                 !- Reporting Frequency

! ================================================================
! CRITICAL: AFN Linkage Mass Flow Rates (for infiltration calculations)
! ================================================================
OUTPUT:VARIABLE,
    *,                        !- Key Value
    AFN Linkage Node 1 to Node 2 Mass Flow Rate,    !- Variable Name
    Timestep;                 !- Reporting Frequency

OUTPUT:VARIABLE,
    *,                        !- Key Value
    AFN Linkage Node 2 to Node 1 Mass Flow Rate,    !- Variable Name
    Timestep;                 !- Reporting Frequency

! ================================================================
! OPTIONAL: AFN Zone Infiltration ACH (for validation comparison)
! ================================================================
OUTPUT:VARIABLE,
    *,                        !- Key Value
    AFN Zone Infiltration Air Change Rate,    !- Variable Name
    TimeStep;                 !- Reporting Frequency

OUTPUT:VARIABLE,
    *,                        !- Key Value
    AFN Zone Exfiltration Sensible Heat Transfer Rate,    !- Variable Name
    TimeStep;                 !- Reporting Frequency

! ================================================================
! USEFUL: Zone temperatures (for validation and debugging)
! ================================================================
OUTPUT:VARIABLE,
    *,                        !- Key Value
    Zone Mean Air Temperature,    !- Variable Name
    TimeStep;                 !- Reporting Frequency
