    4,                        !- Begin Month
    16,                       !- Begin Day of Month
    2023,                     !- Begin Year
    4,                        !- End Month
    21,                       !- End Day of Month
    2023,                     !- End Year
    tuesday,                  !- Day of Week for Start Day
    yes,                      !- Use Weather File Holidays and Special Days
