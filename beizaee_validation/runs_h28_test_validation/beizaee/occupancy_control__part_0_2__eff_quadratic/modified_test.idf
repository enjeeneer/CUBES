EnergyManagementSystem:Sensor,
    BoilerPLR,                !- Name
    main boiler,              !- OutputVariable or OutputMeter Index Key Name
    Boiler Part Load Ratio;    !- OutputVariable or OutputMeter Name

EnergyManagementSystem:Sensor,
    BoilerOutletTemp,         !- Name
    main boiler,              !- OutputVariable or OutputMeter Index Key Name
    Boiler Outlet Temperature;    !- OutputVariable or OutputMeter Name

EnergyManagementSystem:Actuator,
    BoilerEffCurveOverride,    !- Name
    boiler efficiency curve,    !- Actuated Component Unique Name
    Curve,                    !- Actuated Component Type
    Curve Result;             !- Actuated Component Control Type

EnergyManagementSystem:ProgramCallingManager,
    Initialise EMS Variables,    !- Name
    AfterNewEnvironmentWarmUpIsComplete,    !- EnergyPlus Model Calling Point
    InitialiseBoilerVariables;    !- Program Name 1

EnergyManagementSystem:ProgramCallingManager,
    Boiler Efficiency Adjustment,    !- Name
    AfterPredictorAfterHVACManagers,    !- EnergyPlus Model Calling Point
    AdjustBoilerEfficiency;    !- Program Name 1

EnergyManagementSystem:ProgramCallingManager,
    Count Boiler Cycles,      !- Name
    EndOfSystemTimestepBeforeHVACReporting,    !- EnergyPlus Model Calling Point
    CountBoilerCycles;        !- Program Name 1

EnergyManagementSystem:Program,
    InitialiseBoilerVariables,    !- Name
    SET BoilerOnPrev = 0,     !- Program Line 1
    SET BoilerCycleCount = 0;    !- Program Line 2

EnergyManagementSystem:Program,
    AdjustBoilerEfficiency,    !- Name
    SET PLR = BoilerPLR,      !- Program Line 1
    SET Tflow = BoilerOutletTemp,    !- Program Line 2
    SET PLRmin = 0.34,        !- Program Line 3
    SET k = 0.15,             !- Program Line 4
    SET EffBase = 1.24978489 + 0.181034673*PLR - 0.171652899*PLR*PLR - 0.00737313433*Tflow + 0.00003125*Tflow*Tflow + 0.000373134328*PLR*Tflow,    !- Program Line 5
    IF PLR < PLRmin,          !- Program Line 6
    SET Penalty = (1 - PLR/PLRmin)*(1 - PLR/PLRmin),    !- Program Line 7
    SET EffAdj = EffBase*(1 - k*Penalty),    !- Program Line 8
    ELSE,                     !- Program Line 9
    SET EffAdj = EffBase,     !- Program Line 10
    ENDIF,                    !- Program Line 11
    SET BoilerEffCurveOverride = EffAdj;    !- Program Line 12

EnergyManagementSystem:Program,
    CountBoilerCycles,        !- Name
    IF (BoilerPLR > 0.01),    !- Program Line 1
    IF (BoilerOnPrev == 0),    !- Program Line 2
    SET BoilerCycleCount = BoilerCycleCount + 1,    !- Program Line 3
    ENDIF,                    !- Program Line 4
    SET BoilerOnPrev = 1,     !- Program Line 5
    ELSE,                     !- Program Line 6
    SET BoilerOnPrev = 0,     !- Program Line 7
    ENDIF;                    !- Program Line 8

EnergyManagementSystem:GlobalVariable,
    BoilerOnPrev,             !- Erl Variable 1 Name
    BoilerCycleCount;         !- Erl Variable 2 Name

EnergyManagementSystem:OutputVariable,
    Boiler Cycles,            !- Name
    BoilerCycleCount,         !- EMS Variable Name
    Summed,                   !- Type of Data in Variable
    SystemTimestep;           !- Update Frequency

