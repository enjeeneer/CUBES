ENVIRONMENTALIMPACTFACTORS,
    0.3,                      !- District Heating Efficiency
    3,                        !- District Cooling COP
    0.25,                     !- Steam Conversion Efficiency
    298,                      !- Total Carbon Equivalent Emission Factor From N2O
    25,                       !- Total Carbon Equivalent Emission Factor From CH4
    1;                        !- Total Carbon Equivalent Emission Factor From CO2

FUELFACTORS,
    NaturalGas,               !- Existing Fuel Resource Name
    ,                         !- Units of Measure
    ,                         !- Energy per Unit Factor
    1,                        !- Source Energy Factor
    ,                         !- Source Energy Schedule Name
    52;                       !- CO2 Emission Factor

FUELFACTORS,
    Electricity,              !- Existing Fuel Resource Name
    ,                         !- Units of Measure
    ,                         !- Energy per Unit Factor
    ,                         !- Source Energy Factor
    ,                         !- Source Energy Schedule Name
    0.2777777777777778,       !- CO2 Emission Factor
    Grid Carbon Intensity Schedule;    !- CO2 Emission Factor Schedule Name

