    naturalgas,               !- Existing Fuel Resource Name
    ,                         !- Units of Measure
    ,                         !- Energy per Unit Factor
    1,                        !- Source Energy Factor
    ,                         !- Source Energy Schedule Name
    52;                       !- CO2 Emission Factor

