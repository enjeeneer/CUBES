#!/bin/bash
#SBATCH -A CABRERA-SERRENHO-SL3-CPU
#SBATCH -p icelake
#SBATCH --mem=6840
#SBATCH -N 1
#SBATCH -t 01:30:00
#SBATCH -J p-jjjl-thermostat-final
#SBATCH --array=0-311

source ~/.bashrc

YEARS=("2022" "2023")
CASES=(0)
REPS=(0)
TEMP_SEEDS=(42 30 10 15)
COMFORT_TEMPS=(18 19 20 21)
SETBACK_TEMPS=(13 15 17)
ON_OFF_SEEDS=(5 15 10)
ZONES=(0 9)

generate_params() {
    local year=$1
    local case=$2
    local rep=$3
    local temp_seed=$4
    local on_off_seed=$5
    local zone=$6
    local comfort_temp=$7
    local setback_temp=$8
    local wandb_name="paper2_final_runs_v4"

    echo "--exp_type thermostat --zone $zone --heating_set_temp_seed $temp_seed --heating_on_off_seed $on_off_seed --algorithm rbc --rbc_switch 2 --case $case --rep $rep --wandb_name $wandb_name --wandb_tags rbc final paper2 --year $year --comfort_temp_setpoint $comfort_temp --setback_temp_setpoint $setback_temp --wandb_entity jjjl4 --wandb_project jack-observations --run_id True"
}

num_years=${#YEARS[@]}
num_cases=${#CASES[@]}
num_reps=${#REPS[@]}
num_temp_seeds=${#TEMP_SEEDS[@]}
num_zones=${#ZONES[@]}
num_comfort_temps=${#COMFORT_TEMPS[@]}
num_setback_temps=${#SETBACK_TEMPS[@]}
num_on_off_seeds=${#ON_OFF_SEEDS[@]}

total_combinations_zone0=$((num_years * num_cases * num_reps * num_temp_seeds * num_on_off_seeds * num_comfort_temps * num_setback_temps))
total_combinations_zone9=$((num_years * num_cases * num_reps * num_comfort_temps * num_setback_temps))

total_combinations=$((total_combinations_zone0 + total_combinations_zone9))

index=$SLURM_ARRAY_TASK_ID

if [ $index -lt $total_combinations_zone0 ]; then
    # Handle Zone 0 (all parameters vary)
    zone=0

    combination_index=$index
    year_index=$((combination_index % num_years))
    combination_index=$((combination_index / num_years))

    case_index=$((combination_index % num_cases))
    combination_index=$((combination_index / num_cases))

    rep_index=$((combination_index % num_reps))
    combination_index=$((combination_index / num_reps))

    temp_seed_index=$((combination_index % num_temp_seeds))
    combination_index=$((combination_index / num_temp_seeds))

    on_off_seed_index=$((combination_index % num_on_off_seeds))
    combination_index=$((combination_index / num_on_off_seeds))

    comfort_temp_index=$((combination_index % num_comfort_temps))
    combination_index=$((combination_index / num_comfort_temps))

    setback_temp_index=$((combination_index % num_setback_temps))

    year=${YEARS[$year_index]}
    case=${CASES[$case_index]}
    rep=${REPS[$rep_index]}
    temp_seed=${TEMP_SEEDS[$temp_seed_index]}
    on_off_seed=${ON_OFF_SEEDS[$on_off_seed_index]}
    comfort_temp=${COMFORT_TEMPS[$comfort_temp_index]}
    setback_temp=${SETBACK_TEMPS[$setback_temp_index]}
else
    # Handle Zone 9 (only comfort_temp and setback_temp vary)
    zone=9

    combination_index=$((index - total_combinations_zone0))

    year_index=$((combination_index % num_years))
    combination_index=$((combination_index / num_years))

    case_index=$((combination_index % num_cases))
    combination_index=$((combination_index / num_cases))

    rep_index=$((combination_index % num_reps))
    combination_index=$((combination_index / num_reps))

    comfort_temp_index=$((combination_index % num_comfort_temps))
    combination_index=$((combination_index / num_comfort_temps))

    setback_temp_index=$((combination_index % num_setback_temps))

    year=${YEARS[$year_index]}
    case=${CASES[$case_index]}
    rep=${REPS[$rep_index]}
    temp_seed=${TEMP_SEEDS[0]}  # Fixed for Zone 9
    on_off_seed=${ON_OFF_SEEDS[0]}  # Fixed for Zone 9
    comfort_temp=${COMFORT_TEMPS[$comfort_temp_index]}
    setback_temp=${SETBACK_TEMPS[$setback_temp_index]}
fi

PARAMS=$(generate_params $year $case $rep $temp_seed $on_off_seed $zone $comfort_temp $setback_temp)

singularity run cubes-cluster.simg python3.9 main_jack.py $PARAMS

# Generate the search string
Eplus_search_string="thermostat_rbc_eco_year_${year}_case_${case}_rep_${rep}_zone_${zone}_onoffseed_${on_off_seed}_tempseed_${temp_seed}_comforttemp_${comfort_temp}_setbacktemp_${setback_temp}_paper2_final_runs_v4-res1"

# Run the cleanup script with the search string as an argument
singularity run cubes-cluster.simg python3.9 collect_results.py "$Eplus_search_string" "final_runs_v4"
