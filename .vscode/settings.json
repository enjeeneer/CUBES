{
    "notebook.output.textLineLimit": 100,
    "[python]": {
        "editor.defaultFormatter": "ms-python.black-formatter"
    },
    "python.languageServer": "None",
    "python.formatting.provider": "none",
    "python.analysis.exclude": [
        "**/results",
        "**/inputs",
        "**/train",
        "**/wandb",
        "**/outputs",
        "**/*.zip",
        "**/*.sub"
    ],
    "files.exclude": {
        "**/__pycache__": true,
        "**/.mypy_cache": true,
        "**/.pytest_cache": true
    },
    "search.exclude": {
        "**/results": true,
        "**/inputs": true,
        "**/train": true
    }
}